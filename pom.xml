<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.santiagohenn</groupId>
    <artifactId>lora-simulator</artifactId>
    <version>1.0.0</version>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Event-based simulator of LoRa direct-to-satellite uplink traffic over LEO constellations</description>
    <packaging>jar</packaging>

    <properties>
        <!-- The sources use Java 16+ language features (records, pattern matching for instanceof,
             Stream.toList()). JDK 17 (LTS) or newer is required to build. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Default entry point for `mvn exec:java` (override with -Dexec.mainClass=...) -->
        <exec.mainClass>LoraConstellationSimulator</exec.mainClass>
    </properties>

    <dependencies>
        <!--
            satellite-tools and constellation-toolkit are NOT published on Maven Central.
            They must be built from source and installed into the local Maven repository first:
              https://github.com/santiagohenn/satellite-tools      (version 2.1.1)
              https://github.com/santiagohenn/constellation-toolkit (version 1.2.8)
            See README.md, section "Installation".
        -->
        <dependency>
            <groupId>com.santiagohenn</groupId>
            <artifactId>satellite-tools</artifactId>
            <version>2.1.1</version>
        </dependency>
        <dependency>
            <groupId>com.santiagohenn</groupId>
            <artifactId>constellation-toolkit</artifactId>
            <version>1.2.8</version>
        </dependency>
        <dependency>
            <groupId>org.orekit</groupId>
            <artifactId>orekit</artifactId>
            <version>13.1</version>
        </dependency>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>1.9.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>23.0.0</version>
            <scope>compile</scope>
        </dependency>
        <!-- The following three are not imported directly by this repository's sources
             (commons-math3 only by a test). They are kept because the locally installed
             satellite-tools / constellation-toolkit jars may rely on them at runtime. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
        </dependency>
        <dependency>
            <groupId>gov.nasa</groupId>
            <artifactId>worldwind</artifactId>
            <version>2.0.0-986</version>
        </dependency>
        <dependency>
            <groupId>me.tongfei</groupId>
            <artifactId>progressbar</artifactId>
            <version>0.9.0</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Runs an entry point with the full dependency classpath, e.g.
                 mvn -q compile exec:java -Dexec.args="-simulate-pure-aloha -o results/pure-aloha/ ..." -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>

</project>
